# MOTOKO wave-loop 模型配置 — 通用端点定义，引擎代码不含厂商名。
# 协议：openai（/chat/completions）/ anthropic（/messages）/ cli（子进程）
# key 只放环境变量名，绝不落明文。

auditors:
  - name: auditor-a
    protocol: anthropic
    base_url: ${AUDITOR_A_BASE_URL}
    api_key_env: AUDITOR_A_API_KEY
    model: ${AUDITOR_A_MODEL}
    timeout: 1800
  - name: auditor-b
    protocol: cli
    command: ["auditor-cli-tool", "-p"]
    timeout: 1800

adjudicator:
  name: adjudicator
  protocol: openai
  base_url: ${ADJUDICATOR_BASE_URL}
  api_key_env: ADJUDICATOR_API_KEY
  model: ${ADJUDICATOR_MODEL}
  timeout: 900
