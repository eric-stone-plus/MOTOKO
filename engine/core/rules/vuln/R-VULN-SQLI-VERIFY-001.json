{
  "id": "R-VULN-SQLI-VERIFY-001",
  "name": "SQLi verification",
  "category": "vuln",
  "when": {
    "all": [
      {
        "fact": "class",
        "op": "contains",
        "value": "sqli"
      }
    ]
  },
  "then": {
    "hypothesis": "Precise sqlmap injection verification (single thread plus delay; sqlmap defaults are noisy)",
    "actions": [
      {
        "tool": "sqlmap",
        "cmd": "sqlmap -u {url} --batch --level=2 --risk=1 --technique=BE --threads=1 --delay=1 --random-agent",
        "cmd_stealth": "sqlmap -u {url} --batch --level=1 --risk=1 --technique=BE --threads=1 --delay=3 --random-agent"
      }
    ],
    "on_hit_class": "sqli.confirmed",
    "priority": {
      "impact": 0.85,
      "cost": 0.4
    }
  }
}
