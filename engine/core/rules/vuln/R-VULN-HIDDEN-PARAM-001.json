{
  "id": "R-VULN-HIDDEN-PARAM-001",
  "name": "Hidden parameter to injection bridge",
  "category": "vuln",
  "when": {
    "all": [
      {
        "fact": "class",
        "op": "contains",
        "value": "hidden_param"
      },
      {
        "fact": "has_param",
        "op": "eq",
        "value": true
      }
    ]
  },
  "then": {
    "hypothesis": "Use the confirmed hidden parameter for targeted sqlmap and dalfox verification (the has_param gate guarantees a query string; append with & and render the parameter through hyp.param)",
    "actions": [
      {
        "tool": "sqlmap",
        "cmd": "sqlmap -u {url}&{param}=1* --batch --level=2 --risk=1 --technique=BE --threads=1 --delay=1 --random-agent",
        "cmd_stealth": "sqlmap -u {url}&{param}=1* --batch --level=1 --risk=1 --technique=BE --threads=1 --delay=3 --random-agent"
      },
      {
        "tool": "dalfox",
        "cmd": "dalfox url {url}&{param}=1 -p {param} --skip-discovery --no-spinner --user-agent {ua} --delay 2000"
      }
    ],
    "priority": {
      "impact": 0.8,
      "cost": 0.35
    }
  }
}
