{
  "id": "R-TECH-JWT-001",
  "name": "JWT token discovery",
  "category": "tech",
  "when": {
    "any": [
      {
        "fact": "tech",
        "op": "contains",
        "value": "jwt"
      },
      {
        "fact": "class",
        "op": "contains",
        "value": "auth.jwt"
      }
    ]
  },
  "then": {
    "hypothesis": "Test JWT alg=none / kid injection",
    "actions": [
      {
        "tool": "jwt_tool",
        "cmd": "jwt_tool {token} -b -X i"
      },
      {
        "tool": "nuclei",
        "cmd": "nuclei -jsonl -u {url} -tags jwt -rl 5 -c 2 -bs 5 -timeout 10 -duc -H 'User-Agent: {ua}'"
      }
    ],
    "on_hit_class": "auth.jwt_bypass",
    "chain_hint": [
      "R-CHAIN-JWT-ALG-NONE"
    ],
    "priority": {
      "impact": 0.8,
      "cost": 0.2
    }
  }
}