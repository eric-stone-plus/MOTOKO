{
  "id": "R-TECH-JENKINS-001",
  "name": "Jenkins fingerprint",
  "category": "tech",
  "when": {
    "all": [
      {
        "fact": "tech",
        "op": "contains",
        "value": "jenkins"
      }
    ]
  },
  "then": {
    "hypothesis": "Unauthenticated Jenkins script console",
    "actions": [
      {
        "tool": "nuclei",
        "cmd": "nuclei -jsonl -u {url} -tags jenkins -rl 5 -c 2 -bs 5 -timeout 10 -duc -H 'User-Agent: {ua}'"
      }
    ],
    "on_hit_class": "rce",
    "priority": {
      "impact": 0.9,
      "cost": 0.15
    }
  }
}