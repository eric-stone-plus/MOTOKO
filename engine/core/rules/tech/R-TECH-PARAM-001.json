{
  "id": "R-TECH-PARAM-001",
  "name": "Parameter surface",
  "category": "tech",
  "when": {
    "all": [
      {
        "fact": "has_param",
        "op": "eq",
        "value": true
      }
    ]
  },
  "then": {
    "hypothesis": "Mine hidden parameters",
    "actions": [
      {
        "tool": "arjun",
        "cmd": "arjun -u {url} --headers 'User-Agent: {ua}'"
      }
    ],
    "on_hit_class": "info_disclosure.hidden_param",
    "priority": {
      "impact": 0.4,
      "cost": 0.3
    }
  }
}