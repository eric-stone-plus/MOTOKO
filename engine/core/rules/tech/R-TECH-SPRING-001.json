{
  "id": "R-TECH-SPRING-001",
  "name": "Spring Boot fingerprint",
  "category": "tech",
  "when": {
    "all": [
      {
        "fact": "tech",
        "op": "contains",
        "value": "spring"
      }
    ]
  },
  "then": {
    "hypothesis": "Test for exposed Spring actuator endpoints",
    "actions": [
      {
        "tool": "httpx",
        "cmd": "httpx -silent -status-code -json -random-agent=false -H 'User-Agent: {ua}' -u {url}/actuator/env"
      },
      {
        "tool": "nuclei",
        "cmd": "nuclei -jsonl -u {url} -tags springboot,actuator -rl 5 -c 2 -bs 5 -timeout 10 -duc -H 'User-Agent: {ua}'"
      }
    ],
    "on_hit_class": "exposure.actuator_env",
    "chain_hint": [
      "R-CHAIN-ACTUATOR-HEAPDUMP"
    ],
    "priority": {
      "impact": 0.75,
      "cost": 0.15
    }
  }
}