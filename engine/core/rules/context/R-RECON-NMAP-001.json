{
  "id": "R-RECON-NMAP-001",
  "name": "Nmap service and port fingerprinting (Kali container, once per host)",
  "category": "context",
  "when": {
    "all": [
      {
        "fact": "url",
        "op": "matches",
        "value": "^https?://"
      },
      {
        "fact": "status",
        "op": "in",
        "value": [200, 201, 204, 301, 302, 307, 401, 403, 405]
      },
      {
        "fact": "host_nmapped",
        "op": "eq",
        "value": false
      }
    ]
  },
  "then": {
    "hypothesis": "Low-rate nmap -sV service enumeration (containerized; T4 textbook signature downgraded)",
    "actions": [
      {
        "tool": "nmap",
        "runtime": "container",
        "cmd": "nmap -sT -sV --version-intensity 2 -T2 -Pn --top-ports 100 --max-rate 30 --scan-delay 500ms -oX - {host}",
        "cmd_stealth": "nmap -sT -sV --version-intensity 1 -T1 -Pn --top-ports 100 --max-rate 10 --scan-delay 2s -oX - {host}"
      }
    ],
    "on_hit_class": null,
    "priority": {
      "impact": 0.5,
      "cost": 0.8
    }
  }
}
