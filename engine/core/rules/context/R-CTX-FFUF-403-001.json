{
  "id": "R-CTX-FFUF-403-001",
  "name": "Find hidden paths behind 403/401 endpoints",
  "category": "context",
  "when": {
    "all": [
      {
        "fact": "url",
        "op": "matches",
        "value": "^https?://"
      },
      {
        "fact": "status",
        "op": "in",
        "value": [
          401,
          403
        ]
      },
      {
        "fact": "waf",
        "op": "eq",
        "value": false
      },
      {
        "any": [
          {
            "fact": "robots_checked",
            "op": "eq",
            "value": true
          },
          {
            "fact": "host_no_2xx",
            "op": "eq",
            "value": true
          }
        ]
      }
    ]
  },
  "then": {
    "hypothesis": "Low-thread ffuf path discovery for hidden endpoints (skip WAF assets and unprofiled hosts)",
    "actions": [
      {
        "tool": "ffuf",
        "cmd": "ffuf -u {url}/FUZZ -w {wordlist_dir}/common-paths.txt -mc 200,201,204,301,302 -t 2 -p 0.5-2.0 -timeout 10 -H 'User-Agent: {ua}' -json -noninteractive",
        "cmd_stealth": "ffuf -u {url}/FUZZ -w {wordlist_dir}/common-paths.txt -mc 200,201,204,301,302 -t 1 -p 1.0-3.0 -rate 10 -timeout 10 -H 'User-Agent: {ua}' -json -noninteractive"
      }
    ],
    "on_hit_class": null,
    "priority": {
      "impact": 0.5,
      "cost": 0.5
    }
  }
}
