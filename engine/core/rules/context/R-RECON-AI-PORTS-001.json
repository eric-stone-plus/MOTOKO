{
  "id": "R-RECON-AI-PORTS-001",
  "name": "Bounded-cadence AI-console port sweep (sibling ports, once per host)",
  "category": "context",
  "when": {
    "all": [
      {
        "fact": "url",
        "op": "matches",
        "value": "^https?://"
      },
      {
        "fact": "url",
        "op": "matches",
        "value": ":(1234|3001|3080|4000|7860|8786|8787|8788|8789|11434|18899)(/|\\?|#|$)"
      },
      {
        "fact": "status",
        "op": "in",
        "value": [
          200,
          201,
          204,
          301,
          302,
          307,
          401,
          403,
          405
        ]
      },
      {
        "fact": "host_nmapped",
        "op": "eq",
        "value": false
      }
    ]
  },
  "then": {
    "hypothesis": "An AI-conventional port is live on this host and it has never been port-scanned: sweep the AI port set once, rate-capped. This engine holds no request-rate fact, so a measured rate signature (paths/minute, 404 bursts) is not expressible as a rule; the enumeration CADENCE is what this rule encodes, and nmap's top-100 ports miss 8787/11434 by design",
    "detection_risk": "high",
    "actions": [
      {
        "tool": "nmap",
        "runtime": "container",
        "cmd": "nmap -sT -sV --version-intensity 2 -T2 -Pn -p 1234,3001,3080,4000,7860,8786,8787,8788,8789,11434,18899 --max-rate 20 --scan-delay 1s --host-timeout 120s -oX - {host}",
        "cmd_stealth": "nmap -sT -sV --version-intensity 1 -T1 -Pn -p 1234,3001,3080,4000,7860,8786,8787,8788,8789,11434,18899 --max-rate 8 --scan-delay 2s --host-timeout 240s -oX - {host}"
      }
    ],
    "on_hit_class": null,
    "priority": {
      "impact": 0.5,
      "cost": 0.7
    }
  }
}
