{
  "id": "R-RECON-UNCOVER-001",
  "name": "Provider-indexed attack surface (uncover)",
  "category": "context",
  "when": {
    "all": [
      {
        "fact": "url",
        "op": "matches",
        "value": "^https?://"
      },
      {
        "fact": "domain_enumerated",
        "op": "eq",
        "value": false
      }
    ]
  },
  "then": {
    "hypothesis": "Providers index hosts and ports that DNS enumeration never returns",
    "actions": [
      {
        "tool": "uncover",
        "cmd": "uncover -silent -duc -j -q 'domain=\"{domain}\"' -rl 5 -l 50",
        "timeout": 300
      }
    ],
    "on_hit_class": null,
    "priority": {
      "impact": 0.45,
      "cost": 0.25
    }
  }
}
