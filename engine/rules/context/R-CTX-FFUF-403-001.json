{
  "id": "R-CTX-FFUF-403-001",
  "name": "403/401 端点路径爆破找隐藏面",
  "category": "context",
  "when": {
    "all": [
      {
        "fact": "url",
        "op": "matches",
        "value": "^https?://"
      },
      {
        "fact": "status",
        "op": "in",
        "value": [
          401,
          403
        ]
      },
      {
        "fact": "waf",
        "op": "eq",
        "value": false
      },
      {
        "fact": "robots_checked",
        "op": "eq",
        "value": true
      }
    ]
  },
  "then": {
    "hypothesis": "ffuf 低线程路径爆破绕过访问控制找到隐藏端点（WAF 资产与未摸底 host 不点火）",
    "actions": [
      {
        "tool": "ffuf",
        "cmd": "ffuf -u {url}/FUZZ -w {wordlist_dir}/common-paths.txt -mc 200,201,204,301,302 -t 2 -p 0.5-2.0 -timeout 10 -H 'User-Agent: {ua}' -s",
        "cmd_stealth": "ffuf -u {url}/FUZZ -w {wordlist_dir}/common-paths.txt -mc 200,201,204,301,302 -t 1 -p 1.0-3.0 -rate 10 -timeout 10 -H 'User-Agent: {ua}' -s"
      }
    ],
    "on_hit_class": null,
    "priority": {
      "impact": 0.5,
      "cost": 0.5
    }
  }
}
