{
  "id": "R-RECON-NMAP-001",
  "name": "Nmap 服务/端口指纹（Kali 容器，每 host 一次）",
  "category": "context",
  "when": {
    "all": [
      {
        "fact": "url",
        "op": "matches",
        "value": "^https?://"
      },
      {
        "fact": "status",
        "op": "in",
        "value": [200, 201, 204, 301, 302, 307, 401, 403, 405]
      },
      {
        "fact": "host_nmapped",
        "op": "eq",
        "value": false
      }
    ]
  },
  "then": {
    "hypothesis": "nmap -sV 端口服务枚举（容器执行）",
    "actions": [
      {
        "tool": "nmap",
        "runtime": "container",
        "cmd": "nmap -sT -sV -T4 -Pn --top-ports 100 -oX - {host}"
      }
    ],
    "on_hit_class": null,
    "priority": {
      "impact": 0.5,
      "cost": 0.8
    }
  }
}
