{
  "id": "R-CTX-STRIX-DEEP-001",
  "name": "strix 自主深挖利用（高价值资产）",
  "category": "context",
  "when": {
    "any": [
      {"fact": "class", "op": "contains", "value": "vuln.strix_confirmed"},
      {"all": [
        {"fact": "frontier", "op": "==", "value": true},
        {"fact": "type", "op": "==", "value": "url"}
      ]},
      {"fact": "class", "op": "contains", "value": "cve_reported"}
    ]
  },
  "then": {
    "hypothesis": "strix deep 模式自主深挖该资产（枚举隐藏 API、认证流、客户端密钥，非破坏验证全部授权，DoS 禁）",
    "actions": [
      {
        "tool": "strix",
        "cmd": "strix -t {url} -m deep --scope-mode full -n",
        "runtime": "host",
        "timeout": 7200
      }
    ],
    "on_hit_class": "vuln.strix_confirmed",
    "priority": {
      "impact": 0.9,
      "cost": 0.7
    }
  }
}
