{
  "id": "R-BOOT-SCAN-001",
  "name": "通用 nuclei 基线扫描（存活 2xx/3xx 资产）",
  "category": "scan",
  "when": {
    "all": [
      {
        "fact": "url",
        "op": "matches",
        "value": "^https?://"
      },
      {
        "fact": "status",
        "op": "in",
        "value": [200, 201, 204, 301, 302, 307, 401, 403, 405]
      }
    ]
  },
  "then": {
    "hypothesis": "存活端点 nuclei 基线扫描（high/critical）",
    "actions": [
      {
        "tool": "nuclei",
        "cmd": "nuclei -u {url} -jsonl -severity high,critical -rl 5"
      }
    ],
    "on_hit_class": null,
    "priority": {
      "impact": 0.4,
      "cost": 0.5
    }
  }
}
